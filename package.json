{
  "name": "localproxy",
  "version": "0.3.0",
  "private": true,
  "author": "LocalProxy Team",
  "description": "LocalProxy - Electron UI with a Rust networking core",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "dev:electron": "tsc -p electron/tsconfig.json && electron dist-electron/main.js",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1 --port 3000\" \"wait-on http://127.0.0.1:3000 && tsc -p electron/tsconfig.json && VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron dist-electron/main.js\"",
    "build": "vite build",
    "build:electron": "vite build && tsc -p electron/tsconfig.json",
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml",
    "build:mac": "npm run build:rust && npm run build:electron && electron-builder --mac --publish never",
    "build:mac:adhoc": "npm run build:rust && npm run build:electron && electron-builder --mac --publish never --config.afterSign=./scripts/adhoc-sign.cjs && node scripts/cleanup-mac-build.cjs",
    "lint": "tsc --noEmit",
    "package": "npm run build:mac",
    "preview": "vite preview"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.localproxy.desktop",
    "productName": "LocalProxy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "rust/target/release/local_proxy_core",
        "to": "bin/local_proxy_core"
      },
      {
        "from": "rust/target/release/local_proxy_wireguard_helper",
        "to": "bin/local_proxy_wireguard_helper"
      },
      {
        "from": "assets/brand/localproxy-icon.png",
        "to": "appicon/localproxy.png"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "dir"
      ],
      "icon": "electron/localproxy.icns"
    },
    "dmg": {
      "title": "LocalProxy"
    }
  }
}
